{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SConfig",
  "version": "0.3.0",
  "identifier": "local.sconfig.configmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SConfig",
        "create": false,
        "width": 1180,
        "height": 790,
        "minWidth": 780,
        "minHeight": 560,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/sconfig-blue.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "template": "windows/installer.nsi"
      }
    }
  },
  "mainBinaryName": "SConfig"
}
